VITE_NETWORK_ID=preprod
VITE_LOGGING_LEVEL=trace

# ScoreVault has no login: every assessment submission pays its testnet fee from
# this one shared wallet instead of a browser wallet extension. Generate and fund
# it once via `cd bboard-cli && npm run preprod-remote` (option 1, then fund the
# printed address at the preprod faucet), then paste the printed seed below.
# NOTE: this value ships in the client bundle - anyone can read it. That's a
# denial-of-service risk against this shared wallet's testnet funds, not a
# privacy risk against candidates' answers or results.
VITE_SHARED_WALLET_SEED=7373599ac0aae3a182ce1b84f13d834f03e9731c0f4d01c577759c0967a69427

# Local proof server started via `docker compose -f bboard-cli/proof-server-local.yml up -d`.
VITE_PROOF_SERVER_URI=http://127.0.0.1:6300
