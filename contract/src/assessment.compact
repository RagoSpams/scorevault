pragma language_version 0.23;

import CompactStandardLibrary;

export ledger passed: Boolean;

witness computeScore(): Uint<0..11>;

pure circuit maxScore(): Uint<0..11> {
  return 10;
}

pure circuit passingThreshold(): Uint<0..11> {
  return 7;
}

export circuit submitAssessment(): [] {
  const score = computeScore();
  assert(disclose(score <= maxScore()), "Score exceeds maximum possible value");
  passed = disclose(score >= passingThreshold());
}
